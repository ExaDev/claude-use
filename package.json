{
  "name": "claude-use",
  "version": "0.1.1",
  "description": "A profile manager and launcher for Claude Code that lets one person run multiple logins from one machine while controlling what gets shared between them.",
  "license": "Apache-2.0",
  "author": "Joseph Mearman <joseph@mearman.co.uk>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/claude-use.git"
  },
  "homepage": "https://github.com/ExaDev/claude-use#readme",
  "bugs": "https://github.com/ExaDev/claude-use/issues",
  "keywords": [
    "claude-code",
    "claude",
    "cli"
  ],
  "packageManager": "pnpm@11.6.0",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "claude-use": "dist/cli.cjs"
  },
  "files": [
    "dist/cli.cjs"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mts",
    "build:bundle": "node scripts/build.mts --bundle-only",
    "prepublishOnly": "pnpm build:bundle",
    "schema": "node scripts/gen-schema.mts"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "cosmiconfig": "^9.0.2",
    "picomatch": "^4.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/picomatch": "^4.0.3",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
